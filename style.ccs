* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, sans-serif;
    background: #7fc76f;
    display: flex;
    justify-content: center;
    align-items: flex-start;
}

.container {
    width: min(580px, 94%);
    padding-top: 40px;
    padding-bottom: 30px;
}

.banner {
    width: 100%;
    aspect-ratio: 2.5 / 1;
    overflow: hidden;
    border-radius: 18px;
    margin-bottom: 12px;
}

.banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.button {
    width: 100%;
    min-height: 55px;
    margin: 9px 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: rgba(65, 135, 55, 0.65);
    color: white;

    text-decoration: none;
    font-size: 18px;
    font-weight: bold;

    transition: 0.2s;
}

.button:hover {
    background: rgba(50, 115, 45, 0.8);
    transform: translateY(-2px);
}